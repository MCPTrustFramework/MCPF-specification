{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mcpf.dev/schemas/identify-tool-response-v1.json",
  "title": "MCPF Identify Tool Response",
  "description": "Schema for the response returned by the MCPF `identify` MCP tool. Defines the standard structure for server identity, trust framework metadata, credentials, and verification URLs.",
  "type": "object",
  "required": ["identity", "framework", "_note"],
  "additionalProperties": true,
  "properties": {
    "identity": {
      "type": "object",
      "description": "Server and operator identity information",
      "required": ["server"],
      "additionalProperties": true,
      "properties": {
        "server": {
          "type": "object",
          "description": "MCP server identification",
          "required": ["name", "version"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "Machine-readable server identifier (e.g., 'kisc-arch-kultura-valodu-mcp')"
            },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+",
              "description": "Semantic version of the server implementation"
            },
            "description": {
              "type": "string",
              "maxLength": 500,
              "description": "Human-readable description of what the server provides"
            }
          }
        },
        "operator": {
          "type": "object",
          "description": "Organization or individual operating the server",
          "additionalProperties": true,
          "properties": {
            "name": {
              "type": "string",
              "description": "Operator name in primary language"
            },
            "name_en": {
              "type": "string",
              "description": "Operator name in English (if primary language is not English)"
            },
            "jurisdiction": {
              "type": "string",
              "description": "Legal jurisdiction (country or region)"
            },
            "sector": {
              "type": "string",
              "enum": ["Government", "Enterprise", "Academic", "Nonprofit", "Individual", "Other"],
              "description": "Organizational sector"
            }
          }
        },
        "did": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:.+$",
          "description": "Decentralized Identifier (DID) of the server. REQUIRED for Level 1+."
        }
      }
    },
    "framework": {
      "type": "object",
      "description": "MCPF trust framework metadata",
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "const": "MCPF",
          "description": "Framework name. MUST be 'MCPF'."
        },
        "version": {
          "type": "string",
          "description": "MCPF specification version implemented (e.g., '1.0')"
        },
        "layer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "description": "MCPF architecture layer number"
        },
        "compliance": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Compliance tag"
          },
          "description": "Array of MCPF compliance tags indicating capabilities. Standard tags: 'session-trust-metadata', 'tool-based-discovery', 'well-known-discovery', 'credential-verified', 'challenge-response'. Vendor-prefixed tags also allowed."
        },
        "spec": {
          "type": "string",
          "format": "uri",
          "description": "URL to the MCPF specification this server implements"
        }
      }
    },
    "credentials": {
      "type": "object",
      "description": "Verifiable credential information. REQUIRED for Level 3 compliance.",
      "properties": {
        "issuer": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:.+$",
          "description": "DID of the credential issuer (trust anchor)"
        },
        "type": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Credential type array (e.g., ['VerifiableCredential', 'MCPServerVerification'])"
        },
        "subject": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:.+$",
          "description": "DID of the credential subject (should match identity.did)"
        },
        "issued": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of credential issuance"
        },
        "credential_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "URL to fetch the full verifiable credential JSON"
        }
      }
    },
    "verification": {
      "type": "object",
      "description": "URLs for out-of-band verification via .well-known HTTP endpoints. Bridges tool-based discovery to HTTP-based discovery.",
      "properties": {
        "jwks_uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "URL to JSON Web Key Set"
        },
        "did_document": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "URL to DID document (typically /.well-known/did.json). REQUIRED for Level 1+."
        },
        "mcp_manifest": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "URL to signed MCP manifest"
        },
        "trust_registry": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "URL to trust registry metadata"
        },
        "challenge_endpoint": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "URL to challenge-response endpoint for key ownership proof. REQUIRED for Level 2+."
        }
      }
    },
    "_note": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Human-readable trust context note. MUST indicate the trust level of the self-attestation and how to verify claims."
    }
  }
}
