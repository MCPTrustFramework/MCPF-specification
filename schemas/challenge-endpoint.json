{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mcpf.dev/schemas/challenge-endpoint-v1.json",
  "title": "MCPF Challenge-Response Protocol",
  "description": "Schema for mandatory challenge-response endpoint to prove private key ownership",
  "definitions": {
    "challengeRequest": {
      "type": "object",
      "required": ["challenge"],
      "properties": {
        "challenge": {"type": "string", "pattern": "^[A-Za-z0-9+/=]+$", "minLength": 44},
        "nonce": {"type": "string", "pattern": "^[A-Za-z0-9-]+$"},
        "timestamp": {"type": "string", "format": "date-time"}
      }
    },
    "challengeResponse": {
      "type": "object",
      "required": ["challenge", "signature", "publicKey", "verificationMethod", "algorithm", "signedAt"],
      "properties": {
        "challenge": {"type": "string", "pattern": "^[A-Za-z0-9+/=]+$"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9+/=]+$"},
        "publicKey": {"type": "string", "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$"},
        "verificationMethod": {"type": "string", "pattern": "^did:[a-z0-9]+:[^#]+#[^#]+$"},
        "algorithm": {"type": "string", "enum": ["Ed25519", "ES256"]},
        "signedAt": {"type": "string", "format": "date-time"},
        "nonce": {"type": "string"}
      }
    },
    "challengeError": {
      "type": "object",
      "required": ["error", "message"],
      "properties": {
        "error": {"type": "string", "enum": ["invalid_challenge", "signing_failed", "rate_limit_exceeded", "internal_error"]},
        "message": {"type": "string"},
        "retryAfter": {"type": "integer"}
      }
    }
  }
}
